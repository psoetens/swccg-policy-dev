# Machine-local settings: copy to .env (git-ignored) and uncomment what you need. Unset = the defaults shown.
# Gemp fork and branch scripts/setup.sh clones into .cache/gemp-swccg:
# SWCCG_GEMP_URL=https://github.com/psoetens/gemp-swccg.git
# SWCCG_GEMP_BRANCH=feat/brainiac
# Use an existing Gemp clone instead (engine builds read its committed branch, not its working tree):
# SWCCG_GEMP_REPO=/path/to/gemp-swccg
# A JDK 21 / Maven of your own instead of .cache/tools (scripts/machine_env.sh):
# SWCCG_JAVA_HOME=/usr/lib/jvm/temurin-21
# SWCCG_MAVEN_HOME=/opt/apache-maven-3.9.9
# Engine tree / classpath (default .cache/gemp-knowledge-v5, built by scripts/build_knowledge_engine.py):
# SWCCG_ENGINE_TREE=
# SWCCG_ENGINE_DEPS=
# Brainiac server database (scripts/brainiac_server.sh db):
# BRAINIAC_DB_PASSWORD=gemp-dev-local
# BRAINIAC_DB_PORT=35001
# Pull a checkpoint from a training machine with brainiac_release.py --checkpoint HOST:runs/...:
# SWCCG_PULL_HOST=my-gpu-box
