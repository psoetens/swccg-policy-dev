# Plan beta-server: HTTPS for the public name (Let's Encrypt, renewed by Caddy), proxied to Gemp on localhost.
{$SITE} {
	encode gzip
	redir / /gemp-swccg/
	redir /GempArena /GempArena/
	# Amendment 4: the GempArena WebGL client (deploy.sh arena); it talks to this Gemp (same site)
	handle_path /GempArena/* {
		root * /srv/gemparena/current
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:{$GEMP_PORT}
	}
}
