<?xml version="1.0" encoding="UTF-8"?>
<!-- Plan beta-server: warnings and errors, plus Brainiac's INFO lines, to the container log (docker logs). -->
<Configuration status="warn">
  <Appenders>
    <Console name="stdout" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p %c{1} - %m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="com.gempukku.swccgo.ai.brainiac" level="info"/>
    <Root level="warn">
      <AppenderRef ref="stdout"/>
    </Root>
  </Loggers>
</Configuration>
