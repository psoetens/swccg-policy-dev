<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging for local Brainiac tests (scripts/brainiac_server.sh): warnings and errors, plus Brainiac's own INFO lines. -->
<Configuration status="warn">
  <Appenders>
    <Console name="stdout" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} %5p %c{1} - %m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="com.gempukku.swccgo.ai.brainiac" level="debug"/>
    <Root level="warn">
      <AppenderRef ref="stdout"/>
    </Root>
  </Loggers>
</Configuration>
